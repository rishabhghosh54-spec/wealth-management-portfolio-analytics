table holdings_enriched
	lineageTag: 1d883819-4305-4076-aa2a-cc27cc8bf994

	measure 'Total Clients' = DISTINCTCOUNT('holdings_enriched'[client_id])
		formatString: 0
		displayFolder: Portfolio Analytics
		lineageTag: 595d01eb-8950-4d82-969b-d4e0af849a11

	measure 'Total Portfolio Value' = SUM('holdings_enriched'[market_value_inr])
		formatString: ₹ #,0.00;(₹ #,0.00);₹ 0.00
		displayFolder: Portfolio Analytics
		lineageTag: 3b7a5cf0-0054-4cde-9a14-86abc7be1bd0

	measure 'Total Holdings' = COUNTROWS('holdings_enriched')
		formatString: 0
		displayFolder: Portfolio Analytics
		lineageTag: 70974a12-517e-485c-a545-4a82c984e026

	measure 'Unrealized P&L' = SUM('holdings_enriched'[unrealized_pnl_inr])
		formatString: ₹ #,0.00;(₹ #,0.00);₹ 0.00
		displayFolder: Portfolio Analytics
		lineageTag: 5f3f0cd4-fa83-4730-a1ad-53d673836c58

	measure 'Total Cost Basis' = SUM('holdings_enriched'[cost_basis_inr])
		formatString: ₹ #,0.00;(₹ #,0.00);₹ 0.00
		displayFolder: Portfolio Analytics
		lineageTag: 41d24801-6daf-4241-8c38-51e0bb518dac

	measure 'Return on Cost %' = DIVIDE([Unrealized P&L], [Total Cost Basis])
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Portfolio Analytics
		lineageTag: b9677a6f-3c94-4107-ba4a-3c8900c8cf30

	measure 'Average Client Value' = DIVIDE([Total Portfolio Value], [Total Clients])
		formatString: ₹ #,0.00;(₹ #,0.00);₹ 0.00
		displayFolder: Portfolio Analytics
		lineageTag: a73d511c-18b4-4037-aca2-f5d87e3e9a59

	measure 'Portfolio Value (₹ lakh)' = DIVIDE([Total Portfolio Value], 100000)
		formatString: 0.00
		displayFolder: Portfolio Analytics
		lineageTag: 7bf52b1b-7030-4ae9-8526-010bf5944466

	measure 'Cost Basis (₹ lakh)' = DIVIDE([Total Cost Basis], 100000)
		formatString: 0.00
		displayFolder: Portfolio Analytics
		lineageTag: 8fabc012-afef-42c4-8847-8f21eea715e2

	measure 'Unrealized P&L (₹ lakh)' = DIVIDE([Unrealized P&L], 100000)
		formatString: +0.00;-0.00;0.00
		displayFolder: Portfolio Analytics
		lineageTag: a0df87d3-1590-47e4-8417-3e03a1c0f77b

	measure 'Average Client Value (₹ lakh)' = DIVIDE([Average Client Value], 100000)
		formatString: 0.00
		displayFolder: Portfolio Analytics
		lineageTag: 5e9f2bf2-da15-455a-a8cd-c1c9f47747f7

	measure 'Allocation %' = DIVIDE([Total Portfolio Value], CALCULATE([Total Portfolio Value], ALLSELECTED('holdings_enriched')))
		formatString: 0.00%
		displayFolder: Portfolio Analytics
		lineageTag: 9eed3a95-3f44-42a4-93dd-65f0c34fc152

	measure 'Largest Client Share %' = DIVIDE(MAXX(VALUES('holdings_enriched'[client_id]), CALCULATE([Total Portfolio Value])), [Total Portfolio Value])
		formatString: 0.00%
		displayFolder: Portfolio Analytics
		lineageTag: efab7f04-b762-45ec-adeb-f9f5cbf8d108

	measure 'Clients with Gains' = COUNTROWS(FILTER(VALUES('holdings_enriched'[client_id]), CALCULATE([Unrealized P&L]) > 0))
		formatString: 0
		displayFolder: Portfolio Analytics
		lineageTag: 77edc1c8-783d-4ac8-9249-2cc7a0e7f28d

	measure 'Leading Client Value (₹ lakh)' =
			VAR ClientRank = RANKX(ALLSELECTED('holdings_enriched'[client_name]), [Total Portfolio Value], , DESC, DENSE)
			RETURN IF(ClientRank <= 10, [Portfolio Value (₹ lakh)])
		formatString: 0.00
		displayFolder: Portfolio Analytics
		lineageTag: 01352d1f-c834-4fa8-88ca-05be4d073d12

